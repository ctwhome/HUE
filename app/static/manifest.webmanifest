{
	"id": "/",
	"name": "HUE",
	"short_name": "HUE",
	"description": "Projects, Workflows, and reliable Hermes Sessions.",
	"scope": "/",
	"start_url": "/",
	"display": "standalone",
	"background_color": "#09090b",
	"theme_color": "#7c3aed",
	"icons": [
		{
			"src": "/icons/hue-192.png",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "/icons/hue-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "/icons/hue-maskable-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "maskable"
		}
	],
	"shortcuts": [
		{
			"name": "New Session",
			"short_name": "New Session",
			"description": "Start a projectless Hermes Session",
			"url": "/?intent=new-session",
			"icons": [{ "src": "/icons/hue-192.png", "sizes": "192x192" }]
		},
		{
			"name": "Quick Idea",
			"short_name": "Quick Idea",
			"description": "Capture an idea without sending it",
			"url": "/?intent=capture",
			"icons": [{ "src": "/icons/hue-192.png", "sizes": "192x192" }]
		},
		{
			"name": "Projects",
			"short_name": "Projects",
			"url": "/?intent=projects",
			"icons": [{ "src": "/icons/hue-192.png", "sizes": "192x192" }]
		},
		{
			"name": "Recent Sessions",
			"short_name": "Recents",
			"url": "/?intent=recents",
			"icons": [{ "src": "/icons/hue-192.png", "sizes": "192x192" }]
		}
	],
	"share_target": {
		"action": "/share",
		"method": "POST",
		"enctype": "multipart/form-data",
		"params": {
			"title": "title",
			"text": "text",
			"url": "url",
			"files": [
				{
					"name": "files",
					"accept": [
						"image/png",
						"image/jpeg",
						"image/gif",
						"image/webp",
						"application/pdf",
						"application/msword",
						"application/vnd.openxmlformats-officedocument.wordprocessingml.document",
						"text/plain",
						"text/markdown",
						"text/csv",
						"application/json",
						"application/xml",
						"text/css",
						"text/typescript",
						"text/x-python",
						"text/x-rust",
						"text/x-go",
						"text/x-java-source",
						"audio/mpeg",
						"audio/wav",
						"audio/ogg",
						"audio/mp4",
						"video/mp4",
						"video/webm",
						"video/quicktime",
						"application/zip",
						"application/gzip",
						"application/x-tar",
						"application/x-7z-compressed"
					]
				}
			]
		}
	}
}
