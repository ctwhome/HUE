{
	"name": "workspace",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "bun@1.3.14",
	"scripts": {
		"dev": "bun --bun vite dev",
		"build": "vite build",
		"start": "BODY_SIZE_LIMIT=${BODY_SIZE_LIMIT:-60000000} ORIGIN=${ORIGIN:-http://${HOST:-127.0.0.1}:${PORT:-3000}} bun build/index.js",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test": "bun test && bun run test:e2e",
		"test:e2e": "playwright test",
		"android:sync": "../scripts/android-sync.sh",
		"android:build": "../scripts/android-gradle.sh :app:assembleDebug",
		"android:test": "../scripts/android-gradle.sh :app:testDebugUnitTest",
		"android:connected": "../scripts/android-gradle.sh :app:connectedDebugAndroidTest"
	},
	"devDependencies": {
		"@capacitor/cli": "8.5.0",
		"@iconify-json/lucide": "^1.2.126",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/bun": "^1.3.14",
		"@types/react": "19",
		"@types/react-dom": "19",
		"@types/sanitize-html": "^2.16.1",
		"@types/web-push": "^3.6.4",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"unplugin-icons": "^23.0.1",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@agentclientprotocol/sdk": "1.3.0",
		"@capacitor/android": "8.5.0",
		"@capacitor/app": "8.1.1",
		"@capacitor/core": "8.5.0",
		"@excalidraw/excalidraw": "0.18.1",
		"@floating-ui/dom": "^1.8.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@git-diff-view/svelte": "^0.1.7",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"emoji-picker-element": "1.29.1",
		"emoji-picker-element-data": "1.8.0",
		"marked": "^18.0.10",
		"mermaid": "11.16.0",
		"prismjs": "1.30.0",
		"react": "19",
		"react-dom": "19",
		"sanitize-html": "^2.17.7",
		"web-push": "^3.6.7"
	}
}
